# Copy this file to .env and fill in the values before running
# `docker compose -f docker-compose.meet-voice.yaml up`.
#
# See README.md "Configuration reference" for what each variable does and
# which image (control / agent / both) reads it.

# ---------------------------------------------------------------------------
# Meet bot behavior (control image: meet_voice_bot/config.py)
# ---------------------------------------------------------------------------
MEET_BOT_NAME="Voice Bot"
WAITING_ROOM_TIMEOUT_SECONDS=900
WAIT_FOR_HOST_TIMEOUT_SECONDS=600
MAX_UPTIME_SECONDS=5400
CHROME_BINARY_PATH=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
CONTROL_HTTP_HOST=0.0.0.0
CONTROL_HTTP_PORT=8000

# ---------------------------------------------------------------------------
# Minimal setup switch (see README "Minimal setup"). false (default): the
# bot just joins Meet and meet_voice_bot/audio_probe.py logs the captured
# Meet audio level -- no LiveKit server needed, LIVEKIT_URL/KEY/SECRET below
# are ignored. true: full room/token/dispatch/bridge flow -- fill those in
# and run the agent worker too (docker-compose.meet-voice.yaml).
# ---------------------------------------------------------------------------
LIVEKIT_ENABLED=false

# How often (seconds) audio_probe logs the current capture level, and the
# dBFS threshold above which a window counts as "voice" rather than silence.
# Only used while LIVEKIT_ENABLED=false.
AUDIO_PROBE_LOG_INTERVAL_SECONDS=1.0
AUDIO_PROBE_SILENCE_THRESHOLD_DBFS=-50.0

# ---------------------------------------------------------------------------
# Self-hosted LiveKit server -- only required when LIVEKIT_ENABLED=true
# (control image mints tokens/dispatches agent; agent image connects as a
# worker). Run your own `livekit-server` -- see docker-compose.meet-voice.yaml
# -- or point at any self-hosted instance.
# ---------------------------------------------------------------------------
LIVEKIT_URL="ws://livekit:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_change_me_min_32_chars_long"

# Must match between control and agent images: the control plane dispatches
# the agent job under this name, and the agent worker registers under it.
AGENT_NAME="meet-voice-agent"

# ---------------------------------------------------------------------------
# Local assistant record selection (both images; see assistants/*.yaml)
# ---------------------------------------------------------------------------
ASSISTANT_REF="meet-voice-bot-v1"
ASSISTANTS_DIR="./assistants"

# ---------------------------------------------------------------------------
# Provider API keys -- AGENT IMAGE ONLY. Never set these on the control/meet
# image; the Meet-joiner has no business talking to an STT/LLM/TTS provider.
# Only the keys used by your assistants/*.yaml record(s) are required.
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=""
OPENAI_API_KEY=""
CARTESIA_API_KEY=""
# ELEVENLABS_API_KEY=""
# SARVAM_API_KEY=""
# GOOGLE_API_KEY=""          # only for assistant_mode: realtime, provider: gemini

# Path to a local Silero VAD ONNX model file, used by the agent's SpeechGate
# hard input-gate (separate from the livekit-plugins-silero VAD used for
# cascade endpointing). See meet-agent/audio_denoise.py.
SILERO_VAD_ONNX_PATH="/app/models/silero_vad.onnx"
